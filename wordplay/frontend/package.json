{
  "name": "word-play",
  "version": "0.0.0",
  "scripts": {
    "build": "ng build && node scripts/generate-sw.mjs",
    "build:gh-pages": "ng build --configuration production --base-href /word-play/ && node scripts/generate-sw.mjs --gh-pages",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ng": "ng",
    "start": "ng serve",
    "test": "ng test",
    "watch": "ng build --watch --configuration development"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@taiga-ui/cdk": "^5.16.0",
    "@taiga-ui/core": "^5.16.0",
    "@taiga-ui/icons": "^5.16.0",
    "@taiga-ui/kit": "^5.16.0",
    "@taiga-ui/styles": "^5.16.0",
    "rxjs": "~7.8.0",
    "taiga-ui": "^5.16.0",
    "tslib": "^2.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.0",
    "@taiga-ui/eslint-plugin-experience-next": "^0.553.0",
    "eslint": "^9.39.5",
    "jsdom": "^27.1.0",
    "less": "^4.8.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "workbox-build": "^7.4.1"
  }
}
